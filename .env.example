# --- Core ---
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://greenrev:greenrev@localhost:5432/greenrev_suite
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,https://greenrevs.com

# --- File storage (local disk by default) ---
UPLOAD_DIR=./uploads

# --- GreenRev integration ---
# Shared HS256 secret used by the existing GreenRev app to sign SSO tokens
GREENREV_SSO_SECRET=
# Marketplace listings API exposed by greenrevs.com (leave empty to log-only)
GREENREV_MARKETPLACE_URL=
GREENREV_MARKETPLACE_API_KEY=
# HMAC secret the marketplace uses to sign webhooks it sends us (leads, listing status)
GREENREV_WEBHOOK_SECRET=
# Run the marketplace outbox worker inside the API process
RUN_WORKER_IN_PROCESS=true

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# --- Billing (Paystack) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_PRO=
